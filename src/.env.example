# FightBot Environment Configuration
# Add your credentials and settings below

# Discord Bot Credentials (REQUIRED)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Specify a test guild for development mode
GUILD_ID=your_development_guild_id_here

# Environment Settings
NODE_ENV=development  # Options: development, production, test
LOG_LEVEL=info        # Options: debug, info, warn, error

# Bot Configuration
BOT_VERSION=1.0.0-free
CACHE_ENABLED=true
CACHE_TTL=1800000     # Cache time-to-live in ms (30 minutes)

# Analytics and Tracking
ANALYTICS_ENABLED=true

# Database Configuration
DB_PATH=./data/fightbot.db

# Discord Invite Link (auto-generated if not specified)
DISCORD_INVITE_LINK=

# Custom Data Directory (optional)
# DATA_DIRECTORY=./custom-data
