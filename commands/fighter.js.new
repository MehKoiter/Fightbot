import { SlashCommandBuilder, EmbedBuilder } from 'discord.js';
import UfcService from '../services/ufcService.js';
import CommandAnalyticsService from '../services/commandAnalyticsService.js';

// Create a singleton analytics instance
let analyticsDB;
let isInitialized = false;

// Initialize the analytics service
async function getAnalyticsService() {
    if (!analyticsDB) {
        analyticsDB = new CommandAnalyticsService();
    }
    
    if (!isInitialized) {
        try {
            await analyticsDB.init();
            isInitialized = true;
        } catch (error) {
            console.error('Error initializing analytics service:', error);
        }
    }
    
    return analyticsDB;
}

export default {
    data: new SlashCommandBuilder()
        .setName('fighter')
        .setDescription('Get stats for a UFC fighter')
        .addStringOption(option => 
            option
                .setName('name')
                .setDescription('The name of the fighter')
                .setRequired(true)
        ),
        
    async execute(interaction) {
        try {
            await interaction.deferReply();
            
            // Get the fighter name from the interaction
            const fighterName = interaction.options.getString('name');
            
            // Track command usage
            try {
                const analytics = await getAnalyticsService();
                await analytics.trackCommand('fighter');
            } catch (error) {
                console.warn('Error tracking command:', error);
                // Continue execution even if analytics fails
            }
            
            // Create UFC service instance
            const ufcService = new UfcService();
            
            // Get fighter stats (this will now always return at least basic info)
            const fighter = await ufcService.getFighterStats(fighterName);
            
            // Create an embed with the fighter stats
            const statsEmbed = new EmbedBuilder()
                .setColor(0xD20A0A)
                .setTitle(fighter.name)
                .setDescription(`**Record:** ${fighter.record || 'N/A'}`)
                .addFields(
                    { name: '📊 Physical Stats', value: 
                        `Height: ${fighter.height || 'N/A'}\n` +
                        `Weight: ${fighter.weight || 'N/A'}\n` +
                        `Reach: ${fighter.reach || 'N/A'}\n` +
                        `Stance: ${fighter.stance || 'N/A'}\n` +
                        `Born: ${fighter.dateOfBirth || 'N/A'}`,
                        inline: true
                    },
                    { name: '🥊 Strike Stats', value: 
                        `Sig. Strikes/Min: ${fighter.significant_strikes_per_min || 'N/A'}\n` +
                        `Strike Accuracy: ${fighter.significant_strike_accuracy || 'N/A'}\n` +
                        `Strikes Absorbed/Min: ${fighter.significant_strikes_absorbed_per_min || 'N/A'}\n` +
                        `Strike Defense: ${fighter.significant_strike_defense || 'N/A'}`,
                        inline: true
                    },
                    { name: '🤼 Grappling Stats', value: 
                        `Takedowns/15 Min: ${fighter.average_takedowns_per_15_min || 'N/A'}\n` +
                        `Takedown Accuracy: ${fighter.takedown_accuracy || 'N/A'}\n` +
                        `Takedown Defense: ${fighter.takedown_defense || 'N/A'}\n` +
                        `Submissions/15 Min: ${fighter.average_submissions_per_15_min || 'N/A'}`,
                        inline: true
                    }
                )
                .setFooter({ text: 'Data from ESPN MMA • Today at ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) })
                .setURL(fighter.url);
                
            // Add nickname if available
            if (fighter.nickname) {
                statsEmbed.setTitle(`${fighter.name} "${fighter.nickname}"`);
            }
                
            await interaction.editReply({ embeds: [statsEmbed] });
                
        } catch (error) {
            console.error(`Error executing fighter command:`, error);
            
            try {
                // Check if the interaction has been replied to
                if (interaction.deferred) {
                    await interaction.editReply({ 
                        content: '❌ An error occurred while fetching fighter stats. Please try again later.'
                    });
                } else {
                    await interaction.reply({ 
                        content: '❌ An error occurred while fetching fighter stats. Please try again later.',
                        ephemeral: true
                    });
                }
            } catch (replyError) {
                console.error('Error sending error response:', replyError);
            }
        }
    }
};
