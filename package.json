{
  "name": "fightbot-free",
  "version": "1.8.0-free",
  "description": "FightBot Free - Ultimate UFC Discord Bot with Advanced Fighter Features (All Features FREE!)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "node deploy-commands.js --global",
    "deploy:cleanup": "node utils/cleanup-commands.js",
    "deploy:diagnose": "node utils/diagnose-commands.js",
    "test": "node test-runner.js",
    "test:all": "node test-runner.js",
    "test:unit": "node test-runner.js --unit",
    "test:integration": "node test-runner.js --integration",
    "test:performance": "node test-runner.js --performance",
    "test:basic": "node tests/unit/basic-functionality.test.js",
    "test:simple": "node tests/unit/simple-functionality.test.js",
    "test:phase7": "node tests/integration/phase7-features.test.js",
    "test:comprehensive": "node tests/integration/comprehensive.test.js",
    "test:production": "node tests/integration/production-readiness.test.js",
    "test:fighter-timing": "node tests/performance/fighter-timing.test.js",
    "test:autocomplete-timing": "node tests/performance/autocomplete-timing.test.js",
    "test:cache": "node tests/performance/cache-performance.test.js",
    "test:ufc": "node tests/unit/ufc-service.test.js",
    "docs:check": "node docs-health-check.js",
    "docs:info": "echo 'Documentation workflow guide: docs/developer/DOCUMENTATION-WORKFLOW.md'",
    "docs:version": "node -e \"console.log('FightBot v' + require('./package.json').version)\"",
    "setup": "node setup.js",
    "setup:init": "node setup.js init-db",
    "setup:check": "node setup.js check-env",
    "setup:test": "node setup.js test-db",
    "build": "echo 'No build step required for Node.js'",
    "postinstall": "npm run setup:init --omit=dev"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "discord.js": "^14.8.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "sqlite3": "^5.1.6"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
