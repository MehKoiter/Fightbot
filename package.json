{
  "name": "fightbot-free",
  "version": "1.0.0",
  "description": "FightBot - Ultimate UFC Discord Bot (All Features FREE!)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "cross-env NODE_ENV=production node src/deploy-commands.js",
    "deploy:dev": "node src/deploy-commands.js",
    "test": "node test-free.js",
    "test:ufc": "node -e \"import('./src/services/ufcService.js').then(m => new m.default().getUpcomingEvent().then(console.log))\"",
    "setup": "node src/utils/setup.js",
    "setup:init": "node src/utils/setup.js init-db",
    "setup:check": "node src/utils/setup.js check-env",
    "setup:test": "node src/utils/setup.js test-db",
    "postinstall": "npm run setup:init"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.3.4",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.8.0",
    "dotenv": "^16.0.3",
    "sqlite3": "^5.1.6"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
