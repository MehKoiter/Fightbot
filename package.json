{
  "name": "fightbot-free",
  "version": "1.7.0-free",
  "description": "FightBot Free - Ultimate UFC Discord Bot with Advanced Fighter Features (All Features FREE!)",
  "main": "index.js",
  "type":"module",
  "scripts": {
    "start": "node index.js",
    "debug-env": "node debug-env.js",
    "dev": "node --watch index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "node deploy-commands.js --global",
    "deploy:railway": "node deploy-commands-railway.js",
    "deploy:cleanup": "node cleanup-commands.js",
    "deploy:diagnose": "node diagnose-commands.js",
    "test": "node test-free.js",
    "test:simple": "node simple-test.js",
    "test:production": "node production-test.js",
    "test:phase7": "node test-phase7.js",
    "test:comprehensive": "node test-comprehensive.js",
    "test:fighter-timing": "node test-fighter-timing.js",
    "test:ufc": "node -e \"import('./services/ufcService.js').then(m => new m.default().getUpcomingEvent().then(console.log))\"",
    "setup": "node setup.js",
    "setup:init": "node setup.js init-db",
    "setup:check": "node setup.js check-env",
    "setup:test": "node setup.js test-db",
    "build": "echo 'No build step required for Node.js'",
    "postinstall": "npm run setup:init --omit=dev"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.3.4",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.8.0",
    "dotenv": "^16.0.3",
    "sqlite3": "^5.1.6",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
